{
  "name": "todo-editor",
  "private": true,
  "version": "1.0.0",
  "description": "TO DO — 简约专业剪辑软件",
  "author": "TO DO",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "spec:validate": "node server/cli.mjs validate",
    "spec:summary": "node server/cli.mjs summary",
    "spec:test": "node --test server/spec/projectSpec.test.mjs server/spec/capabilities.test.mjs server/spec/migrations.test.mjs server/spec/architecture.test.mjs server/spec/ticks.test.mjs server/interchange/otio.test.mjs server/spec/migrationRatchet.test.mjs server/core/core.test.mjs server/core/commands2.test.mjs server/core/commands3.test.mjs server/core/commands4.test.mjs server/core/projectStore.test.mjs && node electron/projectCore.smoke.cjs && node server/spec/__fixtures__/mcp-session.mjs",
    "spec:capabilities": "node -e \"import('./server/spec/capabilities.mjs').then(m=>console.log(JSON.stringify(m.capabilities(),null,2)))\"",
    "todo": "node server/cli.mjs",
    "todo:mcp": "node server/cli.mjs mcp",
    "corner:pack": "node scripts/build-corner-pack.mjs",
    "corner:test": "node scripts/test-corner-production.mjs && node scripts/test-corner-chain.mjs",
    "corner:export": "node scripts/test-corner-export.mjs",
    "extension:pack": "node scripts/pack-extension.mjs",
    "extension:test": "node scripts/test-extension-packs.mjs && node scripts/test-extension-import.mjs",
    "native:setup": "node scripts/setup-native.mjs",
    "native:build": "node scripts/build-native.mjs",
    "native:test": "node scripts/test-native.mjs",
    "proxy:test": "node scripts/test-proxy.mjs",
    "export:test": "node scripts/test-export.mjs",
    "probe:test": "node scripts/test-probe-transition.mjs",
    "project:test": "node scripts/test-project-file.mjs",
    "pack:paths": "node scripts/test-pack-paths.mjs",
    "pack:smoke": "node scripts/test-pack-smoke.mjs",
    "media:gen": "node scripts/gen-test-media.mjs",
    "fixtures:write": "node scripts/write-fixtures.mjs",
    "golden": "node scripts/golden.mjs",
    "golden:check": "node scripts/golden.mjs --check",
    "preview:test": "node scripts/test-preview-protocol.mjs",
    "timeline:test": "node scripts/test-timeline-tidy.mjs && node scripts/test-timeline-browser.mjs",
    "ui:test": "node scripts/test-workspace-ui.mjs",
    "subtitle:test": "node scripts/test-tts-subtitle-source.mjs",
    "ai:config-check": "node scripts/huniu-config-selfcheck.mjs",
    "vendor:check": "node scripts/vendor-tools-selfcheck.mjs",
    "styles:check": "node scripts/style-pack-selfcheck.mjs",
    "fancy:check": "node scripts/fancy-text-selfcheck.mjs",
    "chalk:test": "node scripts/test-chalk-text.mjs",
    "chalk:enter": "python scripts/test-chalk-enter.py",
    "dynamic:test": "node scripts/test-dynamic-text.mjs",
    "dynamic:production": "node scripts/test-dynamic-production.mjs",
    "dynamic:export": "node scripts/test-dynamic-export.mjs",
    "dynamic:export-raw": "node scripts/test-chalk-export-bake.mjs && node scripts/test-chalk-export-raw.mjs",
    "chalk:integration": "node scripts/test-chalk-integration.mjs",
    "anims:check": "node scripts/anim-pack-selfcheck.mjs",
    "skills:check": "node scripts/skill-pack-selfcheck.mjs",
    "production:test": "node scripts/test-production-timeline.mjs",
    "production:dispatch": "node scripts/test-production-dispatch.mjs",
    "quality:visible": "node scripts/verify-quality-visible.mjs",
    "runstatus:test": "node scripts/test-run-status-text.mjs",
    "motion:check": "npx tsx src/lib/motionPresets.selfcheck.ts",
    "bgm:check": "npx tsx src/lib/bgmLibrary.selfcheck.ts",
    "chapter:check": "npx tsx src/lib/chapterBar.selfcheck.ts",
    "anim": "node scripts/anim-job.mjs",
    "skill": "node scripts/skill-job.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:only": "electron .",
    "dist:win": "npm run native:build && npm run build && electron-builder --win nsis --x64",
    "pack": "npm run dist:win",
    "extension:check": "node scripts/check-extension.mjs",
    "extension:check-test": "node scripts/test-extension-check.mjs",
    "media:test": "node scripts/test-media-cleanup.mjs && node scripts/test-media-management.mjs",
    "segment:test": "node scripts/test-segment-budget.mjs"
  },
  "build": {
    "appId": "com.todo.editor",
    "productName": "TO DO",
    "directories": {
      "output": "C:/todo-editor-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "vendor/**/*",
      "runtime/**/*",
      ".data/ai-config.json",
      "package.json"
    ],
    "asarUnpack": [
      "server/**/*",
      "vendor/**/*",
      "runtime/**/*",
      "douyin-publish/**/*"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "douyin-publish",
        "to": "douyin-publish",
        "filter": [
          "**/*",
          "!archive/inbox/**",
          "archive/inbox/_template/**",
          "archive/inbox/README.txt"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "TO-DO-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "TO DO",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.511.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^10.0.5",
    "electron": "^36.9.5",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^9.1.0"
  }
}
