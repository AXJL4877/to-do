{
  "spec": "todo-skill-pack/1",
  "id": "builtin.chalk-hand",
  "name": "黑板手绘",
  "version": "3.0.0",
  "author": "TO DO",
  "description": "长口播一键成片：AI 先按意思把全文切成口播段，每段单独配音、拆成几块黑板，每块 1~4 个粉笔元素；配音、黑板底、元素书写片段和字幕按时间戳自动铺进时间轴。每个元素可以多出几张候选图挑选、换描述重画或上传自己的图，改哪里只重做哪里。",
  "tags": ["黑板报", "口播", "成片", "配音", "粉笔", "字幕"],
  "previews": ["previews/01-board.png", "previews/02-alpha.png"],
  "pipeline": "production",
  "input": {
    "label": "口播文案",
    "maxLength": 12000,
    "placeholder": "粘贴整篇口播（几千字也行）。空行或 --- 表示这里必须换段；AI 会按意思切段、拆黑板，边讲边画"
  },
  "output": {
    "mime": "video/webm",
    "codec": "vp9",
    "alphaWhen": {}
  },
  "params": [
    {
      "id": "voice", "type": "select", "group": "voice", "label": "音色", "default": "mizai",
      "options": [
        { "value": "mizai", "label": "咪仔" },
        { "value": "clone", "label": "克隆音", "hint": "火山声音复刻 2.0 的音色 ID" }
      ]
    },
    {
      "id": "cloneId", "type": "text", "group": "voice", "label": "克隆音 ID", "when": { "voice": ["clone"] },
      "default": "", "maxLength": 64, "pattern": "^S_[A-Za-z0-9_-]{2,60}$", "placeholder": "S_xxxxxxxx"
    },
    {
      "id": "split", "type": "select", "group": "story", "label": "分段方式", "default": "semantic",
      "options": [
        { "value": "semantic", "label": "AI 按意思", "hint": "AI 找话题转折处切段，顺带定片名和人物外观；空行和 --- 一定换段" },
        { "value": "paragraph", "label": "按段落", "hint": "尽量一个自然段一段，过长的再切" },
        { "value": "length", "label": "按字数", "hint": "按目标字数在句号处切，不调用 AI" }
      ]
    },
    {
      "id": "segmentChars", "type": "number", "group": "story", "label": "每段字数",
      "min": 60, "max": 200, "step": 10, "default": 120, "unit": "字", "hint": "口播段的目标长度；一段 = 一条配音，硬上限 200 字"
    },
    {
      "id": "boardSec", "type": "number", "group": "story", "label": "换板节奏",
      "min": 5, "max": 30, "step": 1, "default": 10, "unit": "秒", "hint": "大约每几秒换一块黑板；AI 仍按意思找换板点"
    },
    {
      "id": "variants", "type": "number", "group": "story", "label": "候选图",
      "min": 1, "max": 4, "step": 1, "default": 1, "unit": "张", "hint": "每个元素先出几张图供挑选；之后也可以单独「再来一张」"
    },
    {
      "id": "layout", "type": "select", "group": "scene", "label": "版式", "default": "auto",
      "options": [
        { "value": "auto", "label": "自动" },
        { "value": "hero_left", "label": "左主角" },
        { "value": "diagonal_fall", "label": "斜线下落" },
        { "value": "conveyor_wave", "label": "传送带" },
        { "value": "fork_right", "label": "右分叉" },
        { "value": "stack_rise", "label": "层层升高" },
        { "value": "climax_right", "label": "右侧高潮" },
        { "value": "grid", "label": "均分网格" }
      ]
    },
    {
      "id": "size", "type": "select", "group": "scene", "label": "画幅", "default": "1920x1080",
      "options": [
        { "value": "1280x720", "label": "16:9 · 720p" },
        { "value": "1920x1080", "label": "16:9 · 1080p" },
        { "value": "1080x1920", "label": "9:16 竖屏" },
        { "value": "1080x1080", "label": "1:1 方形" }
      ]
    },
    {
      "id": "tone", "type": "select", "group": "scene", "label": "笔色", "default": "chalk",
      "options": [
        { "value": "chalk", "label": "白粉笔", "hint": "适合叠在深色画面" },
        { "value": "ink", "label": "深色墨线", "hint": "适合叠在浅色画面" }
      ]
    },
    {
      "id": "palette", "type": "select", "group": "scene", "label": "配色", "default": "color",
      "options": [
        { "value": "color", "label": "彩色粉笔", "prompt": "white chalk with a few vivid red, green, cool blue and pale-yellow chalk accents" },
        { "value": "mono", "label": "纯白粉笔", "prompt": "white chalk only, no colored chalk" }
      ]
    },
    {
      "id": "drawSpeed", "type": "number", "group": "timing", "label": "书写速度",
      "min": 0.5, "max": 3, "step": 0.25, "default": 1, "unit": "×",
      "hint": "越大画得越快、画完停着听；最慢也会在下个元素前画完"
    },
    {
      "id": "tail", "type": "number", "group": "timing", "label": "结尾停留",
      "min": 0, "max": 3, "step": 0.5, "default": 0, "unit": "秒", "hint": "配音结束后停在最后一块黑板；0 = 画面和配音同时结束"
    },
    {
      "id": "fps", "type": "select", "group": "timing", "label": "帧率", "default": "30",
      "options": [
        { "value": "24", "label": "24 fps" },
        { "value": "30", "label": "30 fps" }
      ]
    },
    {
      "id": "hand", "type": "select", "group": "stroke", "label": "粉笔手", "default": "chalk",
      "options": [
        { "value": "chalk", "label": "自动加", "hint": "每个元素入轨时自动套「粉笔手书写」入场动画，之后可在动效里删掉或重加" },
        { "value": "none", "label": "不加", "hint": "只有笔画生长；需要时再在动效里给元素加" }
      ]
    },
    {
      "id": "handSize", "type": "number", "group": "stroke", "label": "手部大小",
      "min": 0.6, "max": 1.4, "step": 0.1, "default": 1, "unit": "×",
      "when": { "hand": ["chalk"] }
    },
    {
      "id": "stroke", "type": "select", "group": "stroke", "label": "笔迹", "default": "skeleton",
      "options": [
        { "value": "skeleton", "label": "沿线条书写", "hint": "骨架追踪，笔尖跟着线走" },
        { "value": "grid", "label": "块状扫写", "hint": "更快，适合大面积涂抹" }
      ]
    },
    {
      "id": "fill", "type": "select", "group": "stroke", "label": "上色", "default": "wipe",
      "options": [
        { "value": "wipe", "label": "写完淡入颜色", "hint": "线稿写完后颜色直接淡入，手不再来回涂" },
        { "value": "none", "label": "只描线" }
      ]
    },
    {
      "id": "quality", "type": "select", "group": "output", "label": "编码质量", "default": "standard",
      "options": [
        { "value": "high", "label": "高" },
        { "value": "standard", "label": "标准" },
        { "value": "draft", "label": "草稿" }
      ]
    },
    {
      "id": "plate", "type": "select", "group": "output", "label": "底板", "default": "board",
      "options": [
        { "value": "board", "label": "黑板底", "hint": "整片铺一张黑板底图在最底层轨道" },
        { "value": "none", "label": "不铺", "hint": "元素是透明的，叠在你自己的画面上" }
      ]
    },
    {
      "id": "subtitles", "type": "select", "group": "output", "label": "字幕", "default": "on",
      "options": [
        { "value": "on", "label": "生成", "hint": "按配音逐字时间戳切好字幕条，进时间轴后可直接改字" },
        { "value": "off", "label": "不要" }
      ]
    },
    {
      "id": "subtitleChars", "type": "number", "group": "output", "label": "每条字数",
      "min": 8, "max": 30, "step": 1, "default": 18, "when": { "subtitles": ["on"] }
    }
  ],
  "quick": ["voice", "split", "size", "variants", "subtitles"],
  "planner": {
    "maxElements": 4,
    "system": "你是黑板报口播的分镜师。一段口播会边讲边在黑板上用粉笔画出来：你先按意思把口播切成几块黑板（一块黑板讲清一个要点），再给每块黑板挑 1~4 个要画的视觉元素，并指定每个元素在讲到哪个短语时开始画。每个元素是一个独立的粉笔小场景或物件簇（例如：拿着钱袋的火柴小人、带锁的房子、向上的箭头和柱状图），不是一行字；也可以是短标题（accent，只写 ≤6 个字的粉笔大字）。人物只用极简粉笔小人，不要真人脸；不要流程图式的图标串、不要四分屏、不要长句抄写；物件上可带 ≤4 字的短标签。"
  },
  "assets": {
    "models": ["gpt-image-2"],
    "resolution": "2K",
    "template": "ONE chalk drawing on a pure flat black background (#000000, no board frame, no wood, no chalk tray, no eraser). {{role}} Draw: {{draw}}. Style: hand-drawn blackboard illustration with dusty broken chalk strokes, {{palette}}. Centered, large in frame with a clear pure-black margin on all sides; everything outside the drawing is pure black.",
    "roles": {
      "hero": "HERO vignette: one clear focal scene, rich but readable.",
      "support": "SUPPORT vignette: a simpler silhouette than a hero scene.",
      "accent": "Short chalk LETTERING only, written exactly as given, with at most one rough underline; no props, no icons."
    },
    "avoid": ["photograph", "photorealistic", "3D render", "real human face", "classroom photo", "four-panel grid", "icon flowchart", "long sentences", "watermark", "green board", "board frame"]
  },
  "runtime": {
    "type": "python",
    "entry": "render.py",
    "timeoutSec": 3600
  }
}
