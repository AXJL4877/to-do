# 复制为同目录 .env 后填写；真 Key 只放 .env，不要提交、不要写进 Skill/Rule

# 派谱 Paipu（备选：--provider paipu / --kind seedance|h3）
LEC_API_KEY=
PAIPU_BASE_URL=https://api.paipu.net/v1
PAIPU_IMAGE_MODEL=lec-tinysnow-image-2
PAIPU_IMAGE_SIZE=3840x2160
PAIPU_VIDEO_MODEL_SEEDANCE=lec-ac-seedance-2-5-900
PAIPU_VIDEO_MODEL_H3=lec-minimax-h3-768p

# 虎妞 Huniu（默认生图 + 默认生视频）
# 也可用小写 huniu_api_key=
HUNIU_API_KEY=
HUNIU_BASE_URL=https://huniuai.com/v1
IMAGE_PROVIDER=huniu
HUNIU_IMAGE_MODEL=gpt-image-2
# 备选（勿当默认）：用户点名 2.5/高端 → gpt-image-2.5-sunburst；flare/快速 → gpt-image-2.5-flare
# CLI: --model gpt-image-2.5-sunburst
HUNIU_IMAGE_SIZE=3840x2160
VIDEO_KIND=grok
HUNIU_VIDEO_MODEL_GROK=grok-imagine-1-5-7tu-special
# 渠道策略默认经济优先（控制台也应选「经济优先 / 价格优先」）
HUNIU_VIDEO_STRATEGY=price_first
# 视觉理解（GM-3.8 Flash）
HUNIU_VISION_MODEL=gemini-3.8-flash

# 文案 chat（纯文本；默认 GPT-6 Astra）
CHAT_KIND=gpt6
HUNIU_CHAT_MODEL=gpt-6-astra
HUNIU_CHAT_MODEL_FABLE5=claude-fable-5
# 备选：fable5.1 → --model fable5.1 / claude-fable-5-1

# 火山豆包语音（配音）
VOLC_SPEECH_API_KEY=
VOLC_SPEECH_RESOURCE_ID=seed-tts-2.0
VOLC_SPEECH_SPEAKER=zh_female_vv_uranus_bigtts

# 成片发布 inbox（可选）
DOUYIN_PUBLISH_INBOX=
